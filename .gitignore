*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
*.spec
pip-wheel-metadata/
*.whl

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.env
*.env

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoint

# --- Data: raw PDFs (large; track via manifest) ---
data/raw/**/*.pdf
data/raw/**/*.PDF

# --- Data: interim & processed large files (optional) ---
